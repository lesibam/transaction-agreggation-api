# =============================================================================
# Development-only environment variables for docker-compose
# Copy to `.env` before running `docker compose up`:
#   cp .env.example .env
#
# NEVER commit a real .env file. All values below are DEV-ONLY placeholders.
# =============================================================================

# Password for the local postgres superuser/app role (POSTGRES_USER=app).
# DEV-ONLY value; replace for anything non-local.
POSTGRES_PASSWORD=dev-only-change-me

# Must be IDENTICAL to POSTGRES_PASSWORD (the API connects as the same user).
# Separate key so production/CI can inject it independently.
SPRING_DATASOURCE_PASSWORD=dev-only-change-me

# JWT signing secret for the API. DEV-ONLY value (clearly non-production).
# Must be at least 32 bytes for HMAC-SHA256.
# Generate a fresh one with: openssl rand -base64 32
APP_SECURITY_JWT_SECRET=dev-only-jwt-secret-0123456789abcdef-0123456789abcdef

# Optional: ingestion schedule (default 60000 = 60s)
# APP_INGESTION_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Kafka listeners (configured directly in docker-compose.yml, documented here)
#   INTERNAL  kafka:29092   - used by containers on the compose network
#                              (SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092)
#   EXTERNAL  localhost:9092 - advertised as localhost so host tools
#                              (kcat, kafka-console-producer, app run outside
#                              Docker) can reach the broker via mapped port 9092
# -----------------------------------------------------------------------------

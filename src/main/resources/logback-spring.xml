<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Structured JSON logs: active for prod, no-profile, and every other
         non-dev profile (e.g. s3demo). Appender defined unconditionally;
         the root ref is chosen per profile below. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"transact"}</customFields>
            <!-- MDC keys (including correlationId set by CorrelationIdFilter) are emitted as top-level JSON fields -->
        </encoder>
    </appender>

    <!-- Development: human-readable console pattern with correlationId and service name -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [service=transact] [correlationId=%X{correlationId:-}] [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="dev, development">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!dev, !development">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

</configuration>

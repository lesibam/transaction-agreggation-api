<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Development: human-readable console pattern with correlationId and service name -->
    <springProfile name="dev, development">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [service=transact] [correlationId=%X{correlationId:-}] [%thread] %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Prod, or default when no profile is active: structured JSON logs -->
    <springProfile name="prod, default">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"transact"}</customFields>
                <!-- MDC keys (including correlationId set by CorrelationIdFilter) are emitted as top-level JSON fields -->
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

</configuration>
